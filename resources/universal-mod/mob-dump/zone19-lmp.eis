Script VCheck#0#12
(
  if
  (
    IsEqual( GSGetVar( 0, "PState" ) , 2 ) 
    IsLess( GetX( GetUnitOfPlayer( 0, 0 )  ) , 472 ) 
    IsLess( GetY( GetUnitOfPlayer( 0, 0 )  ) , 63 ) 
    IsGreater( GetX( GetUnitOfPlayer( 0, 0 )  ) , 440 ) 
    IsGreater( GetY( GetUnitOfPlayer( 0, 0 )  ) , 61 ) 
  )
  then
  (
    KillScript(  ) 
    VTriger#0#15( this ) 
  )
)

