  )
)

Script CreateRunway
(
  if
  (
  )
  then
  (
    KillScript(  ) 
    CreateRunPoint( Add( id, 0 ) , xbase, ybase, dx, dy, -1, 1 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 1 ) , xbase, ybase, dx, dy, -0.75, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 2 ) , xbase, ybase, dx, dy, -0.5, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 3 ) , xbase, ybase, dx, dy, -0.25, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 4 ) , xbase, ybase, dx, dy, 0, 1 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 5 ) , xbase, ybase, dx, dy, 0.25, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 6 ) , xbase, ybase, dx, dy, 0.5, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 7 ) , xbase, ybase, dx, dy, 0.75, 0 ) 
    Sleep( 2 ) 
    CreateRunPoint( Add( id, 8 ) , xbase, ybase, dx, dy, 1, 1 ) 
  )
)

